{
  "name": "tactix",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "TACTIX — Dessine. Anime. Entraîne. Application de tactique et d'entraînement football.",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "typecheck": "tsc --noEmit",
    "test": "tsx scripts/selftest.ts && tsx scripts/smoketest.tsx",
    "test:engine": "tsx scripts/selftest.ts",
    "test:render": "tsx scripts/smoketest.tsx",
    "render": "tsx scripts/render-preview.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3",
    "vite": "^6.0.7"
  }
}
